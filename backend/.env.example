# FlowLens backend environment — names only, never real secrets.
# Copy to .env and fill in values for local development.

# --- Application ---
APP_ENV=development
# Public base URL of the backend (used for OAuth callback URLs)
BACKEND_PUBLIC_URL=http://localhost:8000

# --- Session / crypto ---
# Secret used to sign application session cookies (generate a long random string)
SESSION_SIGNING_SECRET=change-me
# Key used to encrypt GitHub access/refresh tokens at rest
TOKEN_ENCRYPTION_KEY=change-me

# --- GitHub App (see docs/github-app-setup.md) ---
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# GitHub App private key (PEM). Provide the PEM content; newlines may be
# literal or escaped as \n. Server-only secret: never commit or log it.
GITHUB_APP_PRIVATE_KEY=
# OAuth redirect callback: {BACKEND_PUBLIC_URL}/api/v1/auth/github/callback
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback
# Installation callback (configure this in the GitHub App settings):
# {BACKEND_PUBLIC_URL}/api/v1/github/install/callback

# --- Frontend / CORS ---
FRONTEND_ORIGIN=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database ---
DATABASE_URL=sqlite:///./flowlens.db

# --- Storage ---
# Root directory for immutable source snapshots and generated reports.
# Must be outside any public static directory.
STORAGE_ROOT=./storage

# --- Ingestion limits (Phase 3A; also used by ZIP ingestion later) ---
# Maximum number of files stored per snapshot.
SNAPSHOT_MAX_FILE_COUNT=20000
# Maximum total uncompressed bytes per snapshot.
SNAPSHOT_MAX_UNCOMPRESSED_BYTES=268435456
# Maximum compressed archive size fetched from GitHub (bytes).
SNAPSHOT_MAX_ARCHIVE_BYTES=209715200
# Timeout (seconds) for downloading a source archive.
SNAPSHOT_DOWNLOAD_TIMEOUT_SECONDS=60
